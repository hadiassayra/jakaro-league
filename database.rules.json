{
  "rules": {
    ".read": false,
    ".write": false,
    "jakaro": {
      "$tournamentId": {
        ".read": true,
        ".write": "auth != null && auth.token.email_verified === true && auth.token.email === 'hadiassayra@gmail.com'",
        ".validate": "newData.hasChildren(['json', 'updatedAt'])",
        "json": { ".validate": "newData.isString() && newData.val().length <= 4000000" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
